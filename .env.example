# ==================== 复制为 .env 后使用 ====================
#   cp .env.example .env
#
# docker compose 会从这个文件读取变量替换下面的配置项。
# 不建 .env 直接 up，MySQL 容器会因为密码为空起不来。

# ---------- 必填：数据库 ----------
DB_PASSWORD=cuoti_dev_2026
DB_NAME=cuoti_login

# ---------- 必填：JWT 签名密钥 ----------
# 生产环境请换成随机长字符串（≥32 字符），例如：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# ---------- 可选：AI 本地大模型 ----------
# 不配也能跑，只是「AI 解析 / AI 助手」两个按钮会报错，其它功能都正常。
# Docker Desktop（Windows / macOS）用下面这个地址访问宿主机的 Ollama：
AI_API_BASE=http://host.docker.internal:11434
# Linux 请改成 http://172.17.0.1:11434
#
# 模型名要跟 `ollama list` 里看到的完全一致
AI_MODEL=qwen2.5:7b
