# ==================== 复制为 .env 后使用 ====================
#   cp .env.example .env
#
# docker compose 从这个文件读取变量。不建 .env 直接 up，
# MySQL 容器会因为密码为空而启动失败。

# ---------- 必填：数据库 ----------
# ⚠️ 部署到公网前一定要改成自己的强密码
DB_PASSWORD=cuoti_dev_2026
DB_NAME=cuoti_login

# ---------- 必填：JWT 签名密钥 ----------
# ⚠️ 生产环境必须换掉。生成随机串：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# ---------- AI 模型服务（二选一）----------
# ollama  本地跑模型，免费，但需要显卡/内存
# bailian 阿里云百炼，按量计费，不需要本地算力（云服务器小规格推荐这个）
LLM_PROVIDER=ollama

# ---- 选 ollama 时用这几行 ----
# host.docker.internal 在 Docker Desktop 上自带；Linux（含阿里云 ECS）上
# docker-compose.yml 已通过 extra_hosts: host-gateway 映射好，各平台通用。
AI_API_BASE=http://host.docker.internal:11434
AI_MODEL=qwen2.5:7b

# ---- 选 bailian 时用这几行 ----
# ⚠️ key 只写在这个 .env 里（已被 .gitignore 忽略）。
#    不要写进代码、不要发在聊天里、不要提交到 GitHub。
# BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_EMBED_MODEL=text-embedding-v3
