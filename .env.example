# ==================== 复制为 .env 后使用 ====================
#   cp .env.example .env
#
# docker compose 从这个文件读取变量。不建 .env 直接 up，
# MySQL 容器会因为密码为空而启动失败。

# ---------- 必填：数据库 ----------
# ⚠️ 部署到公网前一定要改成自己的强密码
DB_PASSWORD=cuoti_dev_2026
DB_NAME=cuoti_login

# ---------- 必填：JWT 签名密钥 ----------
# ⚠️ 生产环境必须换掉。生成随机串：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# ---------- 可选：AI 本地大模型 ----------
# 不配也能跑，只是「AI 解析 / AI 助手」两个按钮会报错，其它功能都正常。
#
# host.docker.internal 在 Docker Desktop 上自带；Linux（含阿里云 ECS）上
# 本项目的 docker-compose.yml 已经通过 extra_hosts: host-gateway 映射好了，
# 所以这个地址在 Windows / macOS / Linux 上都能直接用。
# 如果 Ollama 装在另一台机器，改成那台机器的内网 IP。
AI_API_BASE=http://host.docker.internal:11434

# 模型名必须和 `ollama list` 里看到的完全一致（带 tag）
AI_MODEL=qwen2.5:7b
