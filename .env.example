# ==================== 复制为 .env 后使用 ====================
#   cp .env.example .env
#
# docker compose 从这个文件读取变量。不建 .env 直接 up，
# MySQL 容器会因为密码为空而启动失败。

# ---------- 必填：数据库 ----------
# ⚠️ 这里必须改成你自己的密码，别直接照抄这个占位符。
#    这个文件是公开的，抄一个公开密码等于数据库密码公开。
#    生成随机密码：python3 -c "import secrets; print(secrets.token_urlsafe(18))"
DB_PASSWORD=replace-with-your-own-strong-password
DB_NAME=cuoti_login

# ---------- 必填：JWT 签名密钥 ----------
# ⚠️ 生产环境必须换掉。生成随机串：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# ---------- AI 模型服务（二选一）----------
# ollama  本地跑模型，免费，但需要显卡/内存
# bailian 阿里云百炼，按量计费，不需要本地算力（云服务器小规格推荐这个）
LLM_PROVIDER=ollama

# ---- 选 ollama 时用这几行 ----
# host.docker.internal 在 Docker Desktop 上自带；Linux（含阿里云 ECS）上
# docker-compose.yml 已通过 extra_hosts: host-gateway 映射好，各平台通用。
AI_API_BASE=http://host.docker.internal:11434
AI_MODEL=qwen2.5:7b
# 本地向量模型，需要先 ollama pull bge-m3（docker-compose 会传给后端）
EMBED_MODEL=bge-m3

# ---- 选 bailian 时用这几行 ----
# ⚠️ key 只写在这个 .env 里（已被 .gitignore 忽略）。
#    不要写进代码、不要发在聊天里、不要提交到 GitHub。
# BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_EMBED_MODEL=text-embedding-v3

# ---------- 认证安全 ----------
# 验证码是否直接放在接口响应里返回。
# 默认只在 APP_ENV=development/testing 时回显；线上**必须**是 0，
# 否则任何人输入一个用户名就能从响应里读到验证码并接管账号。
AUTH_ECHO_CODE=0

# 登录 token 有效期（秒）。改密码/重置密码会立刻吊销所有旧 token。
JWT_EXPIRE_SECONDS=3600

# 图片 cookie 是否加 secure。走 HTTPS 部署时必须设 1。
COOKIE_SECURE=0

# 是否需要登录才能访问 /uploads 下的图片。
# 默认：APP_ENV=production 时开启，其它情况关闭（方便本地直接开图）。
UPLOAD_REQUIRE_AUTH=1

# 限流：置 0 关闭（压测用）。默认在非 testing 环境自动开启。
# AUTH_RATE_LIMIT=0
# AUTH_LOGIN_MAX_FAILURES=5      # 单账号连续输错上限（只计失败）
# AUTH_LOGIN_WINDOW=300
# AUTH_LOGIN_IP_MAX=30           # 单 IP 登录尝试上限（计所有尝试）
# AUTH_SEND_CODE_INTERVAL=60     # 同账号发码最小间隔
# AUTH_SEND_CODE_MAX_PER_USER=5
# AUTH_SEND_CODE_WINDOW=3600
# AUTH_SEND_CODE_IP_MAX=10
# AUTH_VERIFY_MAX_FAILURES=5     # 验证码输错上限
# AUTH_VERIFY_WINDOW=300
# AUTH_REGISTER_IP_MAX=10
