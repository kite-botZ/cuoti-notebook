# 复制此文件为 .env，并填入真实值
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cuoti_login

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_SECONDS=3600

# 找回密码：验证码有效期 + 校验通过后凭证的有效期（秒）
CODE_EXPIRE_SECONDS=300
RESET_TICKET_SECONDS=600
# 是否把验证码直接放在 /api/send-code 的响应里返回。
# 开发环境默认 1（方便调试）；APP_ENV=production 时默认 0 ——
# 真实上线应该把验证码通过短信 / 邮件下发，而不是让接口读回来。
# AUTH_ECHO_CODE=1

APP_ENV=development

# ==================== 连接池 ====================
# 按「进程数 × 每进程并发」估算，别超过 MySQL 的 max_connections
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=3600

# ==================== Redis 缓存 ====================
REDIS_URL=redis://127.0.0.1:6379/0
# 置 1 可以整体关掉缓存（排查「是不是缓存导致的数据不对」时用）
CACHE_DISABLED=0
CACHE_PREFIX=cuoti
# 单次 Redis 命令超时（秒）：超过就当作没缓存，直接回源，不让缓存拖慢接口
CACHE_TIMEOUT=0.1
# AI 解析结果缓存时长（秒），默认 24h
CACHE_EXPLAIN_TTL=86400
# 题目列表缓存时长（秒）
CACHE_QLIST_TTL=300
# 没抢到重建锁时最多等多久别人回填缓存（秒），要大于单次模型生成时间
CACHE_WAIT_TIMEOUT=120

# ==================== 批量导入 ====================
# 每多少条提交一次事务（单块失败只回滚该块）
IMPORT_CHUNK_SIZE=500
# 导入文件大小上限（字节）
IMPORT_MAX_SIZE=10485760

# ==================== AI 模型服务 ====================
# 二选一：ollama（本地跑，免费但要显卡/内存）或 bailian（阿里云百炼，按量计费但快）
LLM_PROVIDER=ollama

# ---------- 选项 A：本地 Ollama ----------
AI_API_BASE=http://localhost:11434
AI_MODEL=gemma3:4b
# 本地向量模型，需要先 ollama pull bge-m3
EMBED_MODEL=bge-m3

# ---------- 选项 B：阿里云百炼（DashScope OpenAI 兼容模式）----------
# 使用步骤：
#   1. 到百炼控制台创建 API-KEY
#   2. 把 LLM_PROVIDER 改成 bailian，并把 key 填到下面
#   3. 跑 python scripts/check_llm.py 验证连通性
# ⚠️ key 只写在这个 .env 文件里（已被 .gitignore 忽略），不要写进代码、不要提交
# BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 对话模型：qwen-plus 效果好，qwen-turbo / qwen-flash 更便宜更快
BAILIAN_MODEL=qwen-plus
# 向量模型：text-embedding-v3（1024 维）
BAILIAN_EMBED_MODEL=text-embedding-v3
# 百炼向量接口对单次条数有限制，超了会报错
BAILIAN_EMBED_BATCH=10
BAILIAN_TIMEOUT=120