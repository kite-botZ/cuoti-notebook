# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# ==================== 虚拟环境 ====================
venv/
.venv/
env/
ENV/

# ==================== 敏感配置 ====================
# 忽略一切 .env 变体（.env / .env.local / .env.production / backend/.env.xxx），
# 只放行模板文件（里面只有占位符）和前端的本地开发地址。
# 之所以写成通配，是因为只写死 ".env" 挡不住 ".env.production" 这种变体。
.env
.env.*
!.env.example
!frontend/.env.development
backend/.env
backend/.env.*
frontend/.env.local
frontend/.env.*.local
*.key
*.pem

# ==================== 上传的文件 ====================
backend/uploads/

# ==================== Node ====================
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==================== IDE ====================
.idea/
.vscode/
*.swp
*.swo

# ==================== 系统 ====================
